# 美术中台 API 配置（复制为 server/.env 并填写）
# 接口地址（base URL），默认 https://arthub.zx.com
ART_API_BASE_URL=https://arthub.zx.com

# 你的 API key（X-Token 或 arthub_token 的值）
ART_API_KEY=

# 鉴权方式：xtoken | apikey | cookie
# xtoken -> X-Token + X-API-KEY 都设成 key（推荐）
# apikey -> 只设 X-API-KEY
# cookie -> Cookie: arthub_token=<key>
ART_API_AUTH_TYPE=xtoken

# 服务端口
PORT=8787
